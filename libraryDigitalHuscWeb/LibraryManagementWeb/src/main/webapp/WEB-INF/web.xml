<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>LibraryManagementWeb</display-name>

    <!-- ===================== FILTERS ===================== -->

    <filter>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <filter-class>vn.edu.husc.library.filter.RoleAuthorizationFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/manager/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/borrow-request</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/my-borrow-requests</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/history</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/favorite-documents</url-pattern>
    </filter-mapping>


    <!-- ===================== PUBLIC / MEMBER SERVLETS ===================== -->

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.LoginServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.RegisterServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.LogoutServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>DocumentServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.DocumentServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>DocumentDownloadServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.DocumentDownloadServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EquipmentServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.EquipmentServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>BorrowRequestServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.BorrowRequestServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>HistoryServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.HistoryServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>DocumentHistoryServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.DocumentHistoryServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EquipmentHistoryServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.EquipmentHistoryServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>FavoriteDocumentServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.FavoriteDocumentServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>ExamBankServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.ExamBankServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>UploadImageServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.UploadImageServlet</servlet-class>
    </servlet>


    <!-- ===================== ADMIN SERVLETS ===================== -->

    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminDashboardServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminDocumentServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminDocumentServlet</servlet-class>
        <multipart-config>
            <max-file-size>52428800</max-file-size>
            <max-request-size>104857600</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet>
        <servlet-name>AdminDocumentFolderImportServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminDocumentFolderImportServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminEquipmentServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminEquipmentServlet</servlet-class>
        <multipart-config>
            <max-file-size>52428800</max-file-size>
            <max-request-size>104857600</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet>
        <servlet-name>AdminBorrowRequestServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminBorrowRequestServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminReturnServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminReturnServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminMaintenanceServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminMaintenanceServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminUserServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminRegistrationServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminRegistrationServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminReportServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminReportServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminSystemLogServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminSystemLogServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminExamBankServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.AdminExamBankServlet</servlet-class>
        <multipart-config>
            <max-file-size>104857600</max-file-size>
            <max-request-size>209715200</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet>
    <servlet-name>DocumentReadServlet</servlet-name>
    <servlet-class>vn.edu.husc.library.servlet.DocumentReadServlet</servlet-class>
</servlet>


    <!-- ===================== MANAGER SERVLET ===================== -->

    <servlet>
        <servlet-name>ManagerServlet</servlet-name>
        <servlet-class>vn.edu.husc.library.servlet.ManagerServlet</servlet-class>
    </servlet>


    <!-- ===================== PUBLIC / MEMBER MAPPINGS ===================== -->

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>DocumentServlet</servlet-name>
        <url-pattern>/documents</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>DocumentDownloadServlet</servlet-name>
        <url-pattern>/document-download</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EquipmentServlet</servlet-name>
        <url-pattern>/equipments</url-pattern>
        <url-pattern>/equipment-detail</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>BorrowRequestServlet</servlet-name>
        <url-pattern>/borrow-request</url-pattern>
        <url-pattern>/my-borrow-requests</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>HistoryServlet</servlet-name>
        <url-pattern>/history</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>DocumentHistoryServlet</servlet-name>
        <url-pattern>/document-history</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EquipmentHistoryServlet</servlet-name>
        <url-pattern>/equipment-history</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FavoriteDocumentServlet</servlet-name>
        <url-pattern>/favorite-documents</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ExamBankServlet</servlet-name>
        <url-pattern>/exam-bank</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>UploadImageServlet</servlet-name>
        <url-pattern>/upload-image/*</url-pattern>
    </servlet-mapping>


    <!-- ===================== ADMIN MAPPINGS ===================== -->

    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminDocumentServlet</servlet-name>
        <url-pattern>/admin/documents</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminDocumentFolderImportServlet</servlet-name>
        <url-pattern>/admin/documents/import-folders</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminEquipmentServlet</servlet-name>
        <url-pattern>/admin/equipments</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminBorrowRequestServlet</servlet-name>
        <url-pattern>/admin/borrow-requests</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminReturnServlet</servlet-name>
        <url-pattern>/admin/return-equipment</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminMaintenanceServlet</servlet-name>
        <url-pattern>/admin/maintenance-records</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminRegistrationServlet</servlet-name>
        <url-pattern>/admin/registrations</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminReportServlet</servlet-name>
        <url-pattern>/admin/reports</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminSystemLogServlet</servlet-name>
        <url-pattern>/admin/system-logs</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminExamBankServlet</servlet-name>
        <url-pattern>/admin/exam-bank</url-pattern>
    </servlet-mapping>


    <!-- ===================== MANAGER MAPPINGS ===================== -->

    <servlet-mapping>
        <servlet-name>ManagerServlet</servlet-name>
        <url-pattern>/manager/dashboard</url-pattern>
        <url-pattern>/manager/equipments</url-pattern>
        <url-pattern>/manager/borrow-requests</url-pattern>
        <url-pattern>/manager/return-equipment</url-pattern>
        <url-pattern>/manager/maintenance-records</url-pattern>
        <url-pattern>/manager/reports</url-pattern>
    </servlet-mapping>
	<servlet-mapping>
    <servlet-name>DocumentReadServlet</servlet-name>
    <url-pattern>/document-read</url-pattern>
</servlet-mapping>

    <!-- ===================== WELCOME ===================== -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>


    <!-- ===================== ERROR PAGES ===================== -->

    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

</web-app>